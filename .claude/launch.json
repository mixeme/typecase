{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "screens",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/screens",
        "-addr",
        ":8085"
      ],
      "port": 8085
    },
    {
      "name": "proof",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/proof"
      ],
      "port": 8084,
      "autoPort": true
    },
    {
      "name": "mockup",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/visual"
      ],
      "port": 8090
    }
  ]
}
