{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "screens",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/screens",
        "-addr",
        ":8085"
      ],
      "port": 8085
    },
    {
      "name": "catalog",
      "runtimeExecutable": "go",
      "runtimeArgs": [
        "run",
        "./cmd/catalog"
      ],
      "port": 8080
    },
    {
      "name": "mockup",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8090",
        "--bind",
        "127.0.0.1",
        "--directory",
        "docs/visual"
      ],
      "port": 8090
    }
  ]
}
